{
  "name": "valora",
  "version": "2.0.0",
  "type": "module",
  "description": "Full-stack ecommerce platform built with the MERN stack",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node --test tests/**/*.test.js",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d",
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "generate-toc": "markdown-toc -i readme.md"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "7.8.11",
    "multer": "2.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "concurrently": "^7.6.0",
    "markdown-toc": "^1.2.0",
    "nodemon": "^2.0.21"
  }
}
